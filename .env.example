# 2FAuth Stack - Umgebungsvariablen
# Kopiere diese Datei nach .env und passe die Werte individuell an:
#   cp .env.example .env

CONTAINER_NAME=2fauth
HTTP_PORT=4444
DATA_DIR=/opt/docker/2fauth

APP_NAME=2FAuth
APP_ENV=production
APP_DEBUG=false
APP_URL=http://otp.arbeitermili.eu
# APP_KEY: 32 Zeichen langer Schlüssel, generiere mit: openssl rand -base64 32
APP_KEY=xxxxxxxxxxxxxxxxxxxxx
APP_TIMEZONE=Europe/Berlin

DB_CONNECTION=sqlite
DB_DATABASE=/2fauth/database/database.sqlite